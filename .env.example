# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
# For Vercel: create a free Neon database at https://neon.tech
# and paste the connection string here
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Session Security ─────────────────────────────────────────────────────────
# A long random string used to sign session cookies
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Admin Credentials ────────────────────────────────────────────────────────
# These are set at deploy time in Vercel's Environment Variables dashboard
ADMIN_USERNAME=Admin.PrintBloom
ADMIN_PASSWORD=your-secure-password-here
ADMIN_PIN=0000

# ─── Node Environment ─────────────────────────────────────────────────────────
# Vercel sets this to "production" automatically — do not set it manually
NODE_ENV=development
