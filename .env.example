# HAVESTORY only — use brand-new Neon, Cloudinary and Vercel projects.
# Never paste or reuse PrintBloom production credentials.

# Neon PostgreSQL (use the pooled connection string)
DATABASE_URL=postgresql://havestory_user:password@havestory-pooler-host/havestory?sslmode=require
NEON_DATABASE_URL=postgresql://havestory_user:password@havestory-pooler-host/havestory?sslmode=require

# Cloudinary product environment
CLOUDINARY_CLOUD_NAME=your_havestory_cloud_name
CLOUDINARY_API_KEY=your_havestory_api_key
CLOUDINARY_API_SECRET=your_havestory_api_secret

# Authentication
SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_USERNAME=Admin.HAVESTORY
ADMIN_PASSWORD=replace_with_a_strong_unique_password
ADMIN_PIN=replace_with_a_unique_4_digit_pin

# Add the exact Vercel production URL after the first deployment.
FRONTEND_ORIGIN=https://your-havestory-project.vercel.app

# Optional email notifications
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Vercel sets NODE_ENV=production automatically.
