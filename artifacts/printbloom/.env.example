# ─── Vercel Deployment Environment Variables ───────────────────────────────
#
# Copy this file to .env.local for local overrides, or set these in the
# Vercel dashboard under Project → Settings → Environment Variables.

# URL of your deployed API server (Railway / Render / etc.)
# Leave empty to use same-origin API (e.g. Replit dev environment).
# Example: https://printbloom-api.up.railway.app
VITE_API_URL=
